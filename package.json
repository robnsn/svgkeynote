{
  "name": "svgkeynote",
  "version": "1.0.0",
  "description": "Convert SVG files to Apple Keynote presentations with natively editable shapes",
  "main": "dist/main.js",
  "bin": {
    "svgkeynote": "lib/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:app",
    "build:cli": "tsc --project tsconfig.cli.json",
    "build:app": "tsc --project tsconfig.lib.json && vite build",
    "dev": "ts-node src/cli.ts",
    "dev:app": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dev": "electron .",
    "electron:build": "npm run build:app && electron-builder",
    "test": "jest",
    "clean": "rm -rf dist lib build release"
  },
  "keywords": [
    "svg",
    "keynote",
    "converter",
    "shapes"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.4.2",
    "jszip": "^3.10.1",
    "svg-parser": "^2.0.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "jest": "^29.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  }
}
